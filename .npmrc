minimum-release-age=0
# pnpm 11 in non-TTY environments (Docker dev) aborts with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY when it wants to remove
# node_modules. CI=true would skip the prompt but ALSO forces a clean
# install that strips devDependencies. Setting confirm-modules-purge=false
# silences the prompt without the side effect, so dev tools like
# `concurrently` survive rspack's internal `pnpm install` invocation.
confirm-modules-purge=false
